{
  "default_agent": "triage-echo",
  "action_policy": {
    "allow_read_only_without_prompt": true,
    "default_action": "require_confirm",
    "mode": "auto"
  },
  "channel_authenticity": {
    "mode": "warn",
    "trusted_channels": ["console"]
  },
  "enabled_channels": ["console"],
  "runtime": {
    "agent_loop_max_steps": 6
  },
  "providers": {
    "ollama": {
      "base_url": "http://127.0.0.1:11434",
      "model": "qwen2.5:3b",
      "temperature": 0.2,
      "timeout_seconds": 120,
      "tool_call_strategy": "native"
    }
  },
  "agents": {
    "triage-echo": {
      "name": "triage-echo",
      "default_channel": "console",
      "provider": "echo",
      "model": "echo-1"
    },
    "triage-openai": {
      "name": "triage-openai",
      "default_channel": "console",
      "provider": "openai",
      "model": "gpt-4.1-mini"
    },
    "triage-gemini": {
      "name": "triage-gemini",
      "default_channel": "console",
      "provider": "gemini",
      "model": "gemini-3.6-flash"
    },
    "triage-cortensor": {
      "name": "triage-cortensor",
      "default_channel": "console",
      "provider": "cortensor-portal",
      "model": "oss-20b"
    },
    "triage-ollama": {
      "name": "triage-ollama",
      "default_channel": "console",
      "provider": "ollama",
      "model": "qwen2.5:3b"
    }
  }
}
