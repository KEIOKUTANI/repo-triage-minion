{
  "default_agent": "triage-echo",
  "action_policy": {
    "allow_read_only_without_prompt": true,
    "default_action": "require_confirm",
    "mode": "auto"
  },
  "channel_authenticity": {
    "mode": "warn",
    "trusted_channels": ["console"]
  },
  "enabled_channels": ["console"],
  "agents": {
    "triage-echo": {
      "name": "triage-echo",
      "default_channel": "console",
      "provider": "echo",
      "model": "echo-1"
    },
    "triage-openai": {
      "name": "triage-openai",
      "default_channel": "console",
      "provider": "openai",
      "model": "gpt-4.1-mini"
    },
    "triage-gemini": {
      "name": "triage-gemini",
      "default_channel": "console",
      "provider": "gemini",
      "model": "gemini-3.6-flash"
    },
    "triage-cortensor": {
      "name": "triage-cortensor",
      "default_channel": "console",
      "provider": "cortensor-portal",
      "model": "oss-20b"
    },
    "triage-ollama": {
      "name": "triage-ollama",
      "default_channel": "console",
      "provider": "ollama",
      "model": "llama3.1"
    }
  }
}
